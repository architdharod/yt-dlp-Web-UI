# Port settings
FRONTEND_PORT=3033

# Download settings
DOWNLOAD_PATH=/data/music/downloads
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=2

# Where the backend keeps queue.db, the persistent job queue. Under compose
# this is a named volume set in docker-compose.yml, so leave it commented out.
# Only set it when running the backend directly on the host.
#DATA_PATH=/config

# UID/GID the backend container runs as. DOWNLOAD_PATH on the host must exist
# and be writable by this user, or the backend refuses to start.
#PUID=1000
#PGID=1000

# Only needed when running `vite dev` against a backend started outside the
# compose stack. Comma-separated list of allowed browser origins.
#CORS_ORIGINS=http://localhost:5173

# Navidrome and Lidarr rescan. Each service is skipped when its variables are
# unset, and the app never fails a download because a rescan failed.

# Base URL of Navidrome, without a trailing /rest.
#NAVIDROME_URL=http://navidrome:4533
# A Navidrome user with the admin flag: startScan is admin-only.
#NAVIDROME_USER=music-for-arr
# The password in plain text; the app derives a token+salt per request.
#NAVIDROME_PASSWORD=change-me

# Base URL of Lidarr, and the API key from Settings > General.
#LIDARR_URL=http://lidarr:8686
#LIDARR_API_KEY=change-me
# The root folder to rescan, as Lidarr sees it. Defaults to Lidarr's first.
#LIDARR_ROOT_FOLDER=/music
