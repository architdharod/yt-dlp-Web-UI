# Port settings
FRONTEND_PORT=3033

# Download settings
DOWNLOAD_PATH=/data/music/downloads
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=2

# How long POST /download/probe may spend reading a collection URL before it
# gives up with a 504. An artist page with many albums costs one yt-dlp call
# per album, so raise this if you routinely paste large discographies.
PROBE_TIMEOUT_SECONDS=120

# YouTube's bot check. When YouTube answers "Sign in to confirm you're not a
# bot", export a Netscape-format cookies file from a browser signed in to a
# throwaway Google account and point these at it. Both are needed under
# compose: the host path is bind-mounted read-only at /cookies/youtube.txt,
# and the backend is told to read it from there. See the README.
#YTDLP_COOKIES_HOST_PATH=/srv/music-for-arr/youtube-cookies.txt
#YTDLP_COOKIES_FILE=/cookies/youtube.txt

# Where the backend keeps queue.db, the persistent job queue. Under compose
# this is a named volume set in docker-compose.yml, so leave it commented out.
# Only set it when running the backend directly on the host.
#DATA_PATH=/config

# UID/GID the backend container runs as. DOWNLOAD_PATH on the host must exist
# and be writable by this user, or the backend refuses to start.
#PUID=1000
#PGID=1000

# Only needed when running `vite dev` against a backend started outside the
# compose stack. Comma-separated list of allowed browser origins.
#CORS_ORIGINS=http://localhost:5173

# Navidrome and Lidarr rescan. Each service is skipped when its variables are
# unset, and the app never fails a download because a rescan failed.

# Base URL of Navidrome, without a trailing /rest.
#NAVIDROME_URL=http://navidrome:4533
# A Navidrome user with the admin flag: startScan is admin-only.
#NAVIDROME_USER=music-for-arr
# The password in plain text; the app derives a token+salt per request.
#NAVIDROME_PASSWORD=change-me

# Base URL of Lidarr, and the API key from Settings > General.
#LIDARR_URL=http://lidarr:8686
#LIDARR_API_KEY=change-me
# The root folder to rescan, as Lidarr sees it. Defaults to Lidarr's first.
#LIDARR_ROOT_FOLDER=/music

# Automatic tag fix. After every download the track is looked up on
# MusicBrainz and, on a confident match, its TITLE and ARTIST are corrected and
# yt-dlp's junk fields are stripped. Set to false to skip the lookup entirely
# (no outbound traffic; downloads keep the tags yt-dlp gave them).
#TAG_FIX_ENABLED=true
# MusicBrainz requires a contact in the User-Agent. Defaults to this project's
# repository URL; set an email or a URL of your own if you run this a lot.
#MUSICBRAINZ_CONTACT=you@example.com
# How long one lookup may take before the job finishes without its fix.
#TAG_FIX_TIMEOUT_SECONDS=60
